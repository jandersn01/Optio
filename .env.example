DEBUG=1
SECRET_KEY=dev-secret-key

POSTGRES_DB=optio
POSTGRES_USER=optio_user
POSTGRES_PASSWORD=optio_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

RABBITMQ_HOST=rabbitmq
RABBITMQ_QUEUE=search_requests
RABBITMQ_RESULTS_QUEUE=search_results

SITE_URL=http://localhost:8000

# LLM (via OpenRouter — compatível com SDK da OpenAI)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Web scraping (Firecrawl)
FIRECRAWL_API_KEY=fc-...

# Em desenvolvimento, imprime e-mails no console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para envio real via SendGrid SMTP, usar:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=optio.notification@gmail.com
# EMAIL_HOST_PASSWORD=sua_api_key_aqui
# DEFAULT_FROM_EMAIL=Optio <optio.notification@gmail.com>


# Job de preferências por área (cron semanal). Vazio = usa defaults (segunda, 08:00, America/Sao_Paulo)
NOTIFY_CRON_DAY_OF_WEEK=
NOTIFY_CRON_HOUR=
NOTIFY_CRON_MINUTE=
NOTIFY_TIMEZONE=

# Job de alertas salvos: intervalo entre verificações (segundos). Default 604800 = 7 dias.
# Para testar, use um valor pequeno (ex.: 120).
ALERTS_INTERVAL_SECONDS=604800

# Máximo de alertas ativos por usuário.
MAX_ACTIVE_ALERTS_PER_USER=3

GOOGLE_CLIENT_ID="seu-id-do-cliente"
GOOGLE_CLIENT_SECRET="sua-chave-secreta"